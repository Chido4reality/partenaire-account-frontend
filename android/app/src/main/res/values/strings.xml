<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- app_name is the LAUNCHER LABEL under the icon. Deliberately the SHORT
         form: Android truncates around 12-13 characters, so "Stenamo Business"
         would show as "Stenamo Busi…". The full name lives in the PWA manifest
         `name` and in the Play Store listing. Matches short_name in
         vite.config.js for the same reason. -->
    <string name="app_name">Stenamo Book</string>
    <string name="title_activity_main">Stenamo Book</string>
    <!-- ⚠️ DO NOT RENAME THE TWO BELOW. com.partenaire.monpartenaire is the
         PERMANENT package identity: it is the Play Store URL, the FileProvider
         authority, and the deep-link scheme. It survives every rebrand and is
         already fully decoupled from the label above via
         android:label="@string/app_name" in AndroidManifest.xml. -->
    <string name="package_name">com.partenaire.monpartenaire</string>
    <string name="custom_url_scheme">com.partenaire.monpartenaire</string>
</resources>
